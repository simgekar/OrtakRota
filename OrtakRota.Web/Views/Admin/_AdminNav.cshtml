@{
    var active = ViewData["AdminTab"] as string;
    string Css(string tab) => tab == active ? "nav-link active" : "nav-link";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 fw-bold mb-0"><i class="bi bi-shield-lock me-1"></i>Yönetim Paneli</h1>
</div>
<ul class="nav nav-pills flex-nowrap overflow-auto mb-4">
    <li class="nav-item"><a class="@Css("Index")" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-1"></i>Özet</a></li>
    <li class="nav-item"><a class="@Css("Users")" asp-controller="Admin" asp-action="Users"><i class="bi bi-people me-1"></i>Kullanıcılar</a></li>
    <li class="nav-item"><a class="@Css("Trips")" asp-controller="Admin" asp-action="Trips"><i class="bi bi-suitcase2 me-1"></i>Geziler</a></li>
    <li class="nav-item"><a class="@Css("Places")" asp-controller="Admin" asp-action="Places"><i class="bi bi-geo-alt me-1"></i>Mekanlar</a></li>
</ul>
