@model JoinTripViewModel
@{
    ViewData["Title"] = "Geziye Katıl";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h1 class="h4 fw-bold mb-1"><i class="bi bi-key me-1"></i>Davet Koduyla Katıl</h1>
                    <p class="text-muted small mb-4">Arkadaşının paylaştığı 6 karakterlik kodu gir.</p>

                    <form asp-action="Join" method="post">
                        <div class="mb-4">
                            <label asp-for="InviteCode" class="form-label"></label>
                            <input asp-for="InviteCode" class="form-control form-control-lg text-uppercase text-center invite-code-input"
                                   maxlength="8" autocomplete="off" placeholder="ABC234" />
                            <span asp-validation-for="InviteCode" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn btn-ortak w-100">Katıl</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
