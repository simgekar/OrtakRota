@model List<TripListItemViewModel>
@{
    ViewData["Title"] = "Gezilerim";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h1 class="h3 fw-bold mb-0">Gezilerim</h1>
        <div class="d-flex gap-2">
            <a asp-action="Join" class="btn btn-outline-secondary"><i class="bi bi-key me-1"></i>Davet Koduyla Katıl</a>
            <a asp-action="Create" class="btn btn-ortak"><i class="bi bi-plus-circle me-1"></i>Yeni Gezi</a>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-suitcase2" style="font-size: 3rem;"></i>
            <p class="mt-3 mb-1">Henüz bir gezin yok.</p>
            <p class="small">Yeni bir gezi oluştur ya da arkadaşının davet koduyla katıl.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var trip in Model)
            {
                <div class="col">
                    <div class="card h-100 feature-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <h2 class="h5 card-title mb-1">@trip.Name</h2>
                                @if (trip.MyRole.HasValue)
                                {
                                    <span class="badge @trip.MyRole.Value.BadgeClass()">@trip.MyRole.Value.ToTurkish()</span>
                                }
                            </div>
                            <p class="text-muted small mb-2">
                                <i class="bi bi-calendar-event me-1"></i>@trip.StartDate.ToString("dd.MM.yyyy") – @trip.EndDate.ToString("dd.MM.yyyy")
                            </p>
                            <p class="small mb-0">
                                <i class="bi bi-person me-1"></i>Kurucu: @trip.OwnerName<br />
                                <i class="bi bi-people me-1"></i>@trip.MemberCount üye
                            </p>
                        </div>
                        <div class="card-footer bg-transparent border-0 pt-0">
                            <a asp-action="Details" asp-route-id="@trip.Id" class="btn btn-sm btn-outline-primary stretched-link">Aç</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
