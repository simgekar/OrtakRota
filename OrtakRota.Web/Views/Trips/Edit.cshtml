@model TripFormViewModel
@{
    ViewData["Title"] = "Geziyi Düzenle";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <a asp-action="Details" asp-route-id="@Model.Id" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> Geziye dön</a>
            <h1 class="h3 fw-bold mt-2 mb-4">Geziyi Düzenle</h1>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                        <input type="hidden" asp-for="Id" />
                        <partial name="_TripForm" model="Model" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-ortak">Kaydet</button>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Vazgeç</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
